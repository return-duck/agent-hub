# ============================================================================
# Agent Stack 部署配置
#
#   cp deploy/deploy.env.example deploy/deploy.env
#   然后按下面的注释逐项填写。deploy.env 已在 .gitignore 里，不会进版本库。
# ============================================================================

# ---------------------------------------------------------------- SSH 连接
# 阿里云 ECS 的公网 IP
DEPLOY_HOST=1.2.3.4
# SSH 用户。用 root 最省事；用普通用户则需要该用户有免密 sudo 权限
DEPLOY_USER=root
DEPLOY_SSH_PORT=22
# 私钥路径；如果用密码登录就留空（rsync/scp 会提示输密码）
DEPLOY_SSH_KEY=~/.ssh/id_rsa

# ---------------------------------------------------------------- 部署位置与端口
# 服务器上的安装根目录（脚本会在这里建 .toolchain / releases / shared / logs）
APP_DIR=/opt/agent-stack
# 对外端口。阿里云【安全组】只需要放行这一个端口（外加 22）
APP_PORT=8081
# runtime 只监听本机，不对外暴露
RUNTIME_PORT=8090

# ---------------------------------------------------------------- MySQL
# 你的服务器上已经装好 MySQL，这里只需要给出连接方式，脚本会创建 schema 与专用账号。
DB_HOST=127.0.0.1
DB_PORT=3306
# 新建的 schema 名（脚本用 CREATE DATABASE IF NOT EXISTS，不会动其它库）
DB_NAME=agent_stack
# 应用使用的专用账号（脚本会创建/更新它，并只授权上面这个 schema）
DB_USER=agentstack
DB_PASSWORD=请改成一个强密码
# 用来建库建号的管理员账号（需要 CREATE DATABASE / CREATE USER / GRANT 权限）
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=你的 MySQL root 密码

# ---------------------------------------------------------------- 模型（平台统一使用 DeepSeek）
# 所有 agent 共用这一个模型；画布图里没有 provider/model/key 的任何痕迹。
MODEL_PROVIDER=deepseek
# 在 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=sk-你的key
# DeepSeek 的模型名会轮换（deepseek-chat / deepseek-reasoner 是旧名，
# 官方当前列出的是 deepseek-flash / deepseek-v4-pro）。启动时 /models 会核对并打印可用列表。
MODEL_NAME=deepseek-flash
# 可选：覆盖 baseURL（走自建网关时用）
MODEL_BASE_URL=
# 可选：透传额外参数（JSON），例如 {"thinking":{"type":"enabled"}}
MODEL_EXTRA_PARAMS=

# http_get 工具的白名单（默认拒绝策略，防 SSRF）。留空则沿用默认值
TOOL_HTTP_ALLOWLIST=example.com,httpbin.org

# ---------------------------------------------------------------- 运行时版本
# 服务器上若无 JDK / Node，脚本会按架构下载官方压缩包到 $APP_DIR/.toolchain（不需要包管理器）
JDK_MAJOR=21
NODE_VERSION=v22.12.0
# 国内必须用镜像：api.adoptium.net 从国内 ECS 拉会卡死（脚本已加超时+卡死检测）
# 脚本的顺序是：复用已下载的 → 复用系统已装的 Java → 本镜像 → USTC 镜像 → 官方源
JDK_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/Adoptium
NODE_MIRROR=https://npmmirror.com/mirrors/node
NPM_REGISTRY=https://registry.npmmirror.com

# ---------------------------------------------------------------- 可选
# 单端口部署：把前端打进 jar，一个端口同时提供 UI 与 API（默认开）
# 改成 0 则只部署 API + runtime（前端你自己用 nginx/CDN 托管 web/dist）
SERVE_WEB=true
