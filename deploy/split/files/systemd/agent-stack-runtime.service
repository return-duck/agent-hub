[Unit]
Description=Agent Stack runtime (Node + LangChain)
Documentation=file://__APP_DIR__
After=network-online.target
Wants=network-online.target
# 同 server：限制重启频率，避免 OOM 抖动把整机拖死
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__RUN_AS__
Group=__RUN_AS__
WorkingDirectory=__APP_DIR__/runtime
EnvironmentFile=__APP_DIR__/shared/runtime.env
Environment=NODE_ENV=production

# 用系统自带的 Node（v22.23.0，已实测），不重复下载
ExecStart=__NODE_BIN__ dist/main.js

Restart=on-failure
RestartSec=15
TimeoutStopSec=15
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
