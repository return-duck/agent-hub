# 复制为 .env 即可生效（.env 已在 .gitignore 中，不会进版本库）
#   cp runtime/.env.example runtime/.env

# ============================================================================
# 模型：平台统一使用 DeepSeek
#
# 所有 agent 共用这一份配置 —— 画布图里没有 provider / model / key 的任何痕迹，
# 换模型只改这里，图与代码都不动。运行时通过 /healthz 把实际生效的模型报给前端。
# ============================================================================
MODEL_PROVIDER=deepseek

# 在 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=sk-你的key

# ⚠️ DeepSeek 的模型名会轮换：deepseek-chat / deepseek-reasoner 是旧名，
#    已知可用：deepseek-chat / deepseek-reasoner / deepseek-v4-pro / deepseek-v4-flash。
#    启动时会调 /models 核对并在日志里打印你账号实际可用的名字。
#    启动时会调 /models 核对一次；如果名字对不上，日志里会直接打印可用列表。
MODEL_NAME=deepseek-chat

# 可选：覆盖 baseURL（例如走自建网关/代理）
# MODEL_BASE_URL=https://api.deepseek.com

# 可选：透传给 provider 的额外参数（JSON），用于库还没跟上的新参数
# MODEL_EXTRA_PARAMS={"thinking":{"type":"enabled"}}

# 可选：流式请求是否索要真实 token 用量（默认 true）。
#       关掉后前端会显示"tokens 为估算值"。
# MODEL_STREAM_USAGE=true

MODEL_TEMPERATURE=0.2

# 完全没有 key 时也不会报错：会自动降级到内置脚本化模型，
# 让整条链路（编译 → 工具循环 → 流式输出 → 事件落库）零凭证可跑通、可测试。

# ============================================================================
# 服务与工具
# ============================================================================
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8090

# 每次模型调用前的上下文预算（字符数，约 4 字符 = 1 token）
MAX_CONTEXT_CHARS=12000

# http_get 工具的白名单与限制（默认拒绝策略，防 SSRF）
TOOL_HTTP_ALLOWLIST=example.com,api.github.com,httpbin.org,localhost
TOOL_TIMEOUT_MS=10000
TOOL_RESULT_MAX_CHARS=2000
