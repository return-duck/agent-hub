# 复制为 .env 即可生效（.env 已在 .gitignore 中，不会进版本库）
#
# 默认无需任何配置：使用内置脚本化模型，全链路可跑通、可测试。
# MODEL_PROVIDER=scripted

# 接入任意 OpenAI 兼容端点（DeepSeek / OpenAI / 通义 / Kimi / Ollama 均可）：
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat
# MODEL_TEMPERATURE=0.2

RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8090

# 每次模型调用前的上下文预算（字符数，约 4 字符 = 1 token）
MAX_CONTEXT_CHARS=12000

# http_get 工具的白名单与限制（默认拒绝，防 SSRF）
TOOL_HTTP_ALLOWLIST=example.com,api.github.com,httpbin.org,localhost
TOOL_TIMEOUT_MS=10000
TOOL_RESULT_MAX_CHARS=2000
