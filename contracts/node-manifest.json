{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-stack.local/contracts/node-manifest.json",
  "title": "NodeManifest",
  "description": "节点能力清单：runtime 据此装配执行器，web 据此渲染配置表单。新增节点类型只需改这里 + 加一个执行器。",
  "version": 1,
  "toolNames": ["calculator", "http_get"],
  "nodeTypes": [
    {
      "type": "start",
      "displayName": "开始",
      "category": "input",
      "description": "运行入口，声明本次运行的输入变量",
      "maxIncoming": 0,
      "maxOutgoing": 1,
      "configSchema": {
        "type": "object",
        "properties": {
          "inputVariables": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "enum": ["string", "number", "boolean", "object"] },
                "required": { "type": "boolean", "default": true },
                "description": { "type": "string" }
              }
            }
          }
        }
      },
      "uiSchema": {
        "inputVariables": {
          "widget": "paramTable",
          "label": "入参",
          "columns": ["name", "type", "description", "required"],
          "valueMode": "none"
        }
      }
    },
    {
      "type": "prompt",
      "palette": false,
      "displayName": "提示词",
      "category": "prompt",
      "description": "把模板渲染成一条消息，支持 {{input.x}} 与 {{scratchpad.y}}",
      "maxIncoming": 1,
      "maxOutgoing": 1,
      "outputs": [
        { "name": "text", "type": "string", "label": "提示词" }
      ],
      "configSchema": {
        "type": "object",
        "required": ["template"],
        "properties": {
          "role": { "enum": ["system", "human"], "default": "human" },
          "template": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["custom", "ref"] },
                  "value": {},
                  "ref": { "type": "string", "default": "" }
                }
              }
            ],
            "default": { "mode": "custom", "value": "", "ref": "" }
          },
          "outputKey": { "type": "string", "default": "prompt" }
        }
      },
      "uiSchema": {
        "template": {
          "widget": "binding",
          "valueType": "string",
          "multiline": true,
          "label": "提示词",
          "placeholder": "请介绍 {{input.topic}}"
        },
        "role": { "widget": "select" }
      }
    },
    {
      "type": "llm",
      "displayName": "大模型",
      "category": "model",
      "description": "调用大语言模型，使用变量和提示词生成回复",
      "maxIncoming": 1,
      "maxOutgoing": 1,
      "outputs": [
        { "name": "output", "type": "string", "label": "output" }
      ],
      "configSchema": {
        "type": "object",
        "properties": {
          "model": { "type": "string", "default": "" },
          "inputs": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "mode": { "enum": ["custom", "ref"], "default": "ref" },
                "ref": { "type": "string", "default": "" },
                "value": {}
              }
            }
          },
          "prompt": { "type": "string", "default": "" },
          "system": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["custom", "ref"] },
                  "value": {},
                  "ref": { "type": "string", "default": "" }
                }
              }
            ],
            "default": ""
          },
          "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.2 },
          "tools": {
            "type": "array",
            "default": [],
            "items": { "enum": ["calculator", "http_get"] }
          },
          "maxSteps": { "type": "integer", "minimum": 1, "maximum": 20, "default": 6 },
          "outputKey": { "type": "string", "default": "answer" }
        }
      },
      "uiSchema": {
        "model": { "widget": "model", "label": "模型" },
        "inputs": {
          "widget": "paramTable",
          "label": "入参",
          "columns": ["name", "value"],
          "valueMode": "ref"
        },
        "prompt": {
          "widget": "textarea",
          "label": "提示词",
          "template": "brace",
          "placeholder": "给定一个主题: {topic}, 写一个100字的小故事"
        },
        "system": { "widget": "hidden" },
        "tools": { "widget": "hidden" },
        "temperature": { "widget": "hidden" },
        "maxSteps": { "widget": "hidden" },
        "outputKey": { "widget": "hidden" }
      }
    },
    {
      "type": "http",
      "palette": false,
      "displayName": "HTTP 调用",
      "category": "http",
      "description": "发起一次 HTTP 请求。URL、请求头、请求体可以选择上游输出（类型须一致），也可以自己填写。结果的状态码、响应体、JSON 可被后续节点选为输入。",
      "maxIncoming": 1,
      "maxOutgoing": 1,
      "outputs": [
        { "name": "status", "type": "number", "label": "状态码" },
        { "name": "ok", "type": "boolean", "label": "是否成功" },
        { "name": "body", "type": "string", "label": "响应体" },
        { "name": "json", "type": "object", "label": "JSON" },
        { "name": "result", "type": "object", "label": "完整响应" }
      ],
      "configSchema": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"], "default": "GET" },
          "url": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["custom", "ref"] },
                  "value": {},
                  "ref": { "type": "string", "default": "" }
                }
              }
            ],
            "default": { "mode": "custom", "value": "", "ref": "" }
          },
          "headers": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["custom", "ref"] },
                  "value": {},
                  "ref": { "type": "string", "default": "" }
                }
              }
            ],
            "default": ""
          },
          "body": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["custom", "ref"] },
                  "value": {},
                  "ref": { "type": "string", "default": "" }
                }
              }
            ],
            "default": ""
          },
          "outputKey": { "type": "string", "default": "http" },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000, "default": 10000 }
        }
      },
      "uiSchema": {
        "method": { "widget": "select" },
        "url": {
          "widget": "binding",
          "valueType": "string",
          "label": "URL",
          "placeholder": "https://example.com/search?q={{input.query}}"
        },
        "headers": {
          "widget": "binding",
          "valueType": "string",
          "multiline": true,
          "label": "请求头",
          "placeholder": "{\"accept\":\"application/json\"}"
        },
        "body": {
          "widget": "binding",
          "valueType": "string",
          "multiline": true,
          "label": "请求体",
          "placeholder": "{\"q\":\"{{input.query}}\"}"
        },
        "timeoutMs": { "widget": "number" }
      }
    },
    {
      "type": "code",
      "displayName": "代码执行",
      "category": "code",
      "description": "执行一段 JavaScript（仅 JS）。每个输入可以选择类型一致的上游输出，或不选而自己填写。return 的值按输出类型提供给后续节点。",
      "maxIncoming": 1,
      "maxOutgoing": 1,
      "outputs": [
        { "name": "result", "type": "object", "label": "返回值" }
      ],
      "configSchema": {
        "type": "object",
        "required": ["source"],
        "properties": {
          "source": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["custom", "ref"] },
                  "value": {},
                  "ref": { "type": "string", "default": "" }
                }
              }
            ],
            "default": "return { text: String(inputs.topic ?? '') };"
          },
          "inputs": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type"],
                  "properties": {
                    "name": { "type": "string" },
                    "type": { "enum": ["string", "number", "boolean", "object"] },
                    "mode": { "enum": ["custom", "ref"], "default": "custom" },
                    "value": {},
                    "ref": { "type": "string", "default": "" }
                  }
                }
              }
            ],
            "default": []
          },
          "outputs": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "enum": ["string", "number", "boolean", "object"] },
                "description": { "type": "string", "default": "" }
              }
            }
          },
          "outputType": { "enum": ["string", "number", "boolean", "object"], "default": "object" },
          "outputKey": { "type": "string", "default": "code" },
          "timeoutMs": { "type": "integer", "minimum": 50, "maximum": 5000, "default": 1000 }
        }
      },
      "uiSchema": {
        "source": {
          "widget": "textarea",
          "label": "代码",
          "placeholder": "return { text: String(inputs.topic ?? '') };"
        },
        "inputs": {
          "widget": "paramTable",
          "label": "入参",
          "columns": ["name", "description", "type", "value"],
          "valueMode": "custom"
        },
        "outputs": {
          "widget": "paramTable",
          "label": "出参",
          "columns": ["name", "type", "description"],
          "valueMode": "none"
        },
        "outputType": { "widget": "hidden" },
        "outputKey": { "widget": "hidden" },
        "timeoutMs": { "widget": "number" }
      }
    },
    {
      "type": "end",
      "displayName": "结束",
      "category": "output",
      "description": "工作流的最终节点，用出参表返回本次运行结果。",
      "maxIncoming": 1,
      "maxOutgoing": 0,
      "configSchema": {
        "type": "object",
        "properties": {
          "value": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["custom", "ref"] },
                  "value": {},
                  "ref": { "type": "string", "default": "" }
                }
              }
            ],
            "default": ""
          },
          "params": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string", "default": "" },
                "type": { "enum": ["string", "number", "boolean", "object"] },
                "mode": { "enum": ["custom", "ref"], "default": "ref" },
                "ref": { "type": "string", "default": "" },
                "value": {}
              }
            }
          },
          "outputKey": { "type": "string", "default": "answer" }
        }
      },
      "uiSchema": {
        "params": {
          "widget": "paramTable",
          "label": "出参",
          "columns": ["name", "description", "type", "value"],
          "valueMode": "ref"
        },
        "value": { "widget": "hidden" },
        "outputKey": { "widget": "hidden" }
      }
    }
  ]
}
