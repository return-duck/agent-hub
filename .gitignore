# 项目内工具链与运行时数据（约 400MB，不入库）
.toolchain/

# Node
node_modules/
dist/
*.log

# Java / Maven
java/target/
!java/.mvn/wrapper/maven-wrapper.jar

# 含密码、API key 的本地配置。示例文件 *.env.example 仍然入库。
.env
.env.*
!.env.example
*.env
!*.env.example
deploy/deploy.env
env.yml

# macOS
.DS_Store

# 运行期产物
*.pid

# TypeScript 增量编译缓存（派生产物，每次编译都会变）
*.tsbuildinfo
