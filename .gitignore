# 项目内工具链与运行时数据（约 400MB，不入库）
.toolchain/

# Node
node_modules/
dist/
*.log

# Java / Maven
server/target/
!server/.mvn/wrapper/maven-wrapper.jar

# 环境变量：可能含 API key
.env
.env.local

# macOS
.DS_Store

# 运行期产物
*.pid

# 部署：真实配置里含密码与 API key
deploy/deploy.env
build/

# TypeScript 增量编译缓存（派生产物，每次编译都会变）
*.tsbuildinfo
